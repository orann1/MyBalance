// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Prisma v7: connection URL is configured in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ManagedSavingsType {
  hishtalmut // Keren Hishtalmut
  gemel // Kupat Gemel
  hashkaa // Gemel LeHashkaa
  savings // Savings policy / managed savings
  other // Private investment / bank account / anything not covered above (Phase 2D-1 QA fix)
}

enum OwnerLabel {
  self
  spouse
  child
  shared
  family
  other
}

enum HoldingStatus {
  active
  inactive
  archived
}

// Phase 2C-1: public fund data source (Data.gov.il datasets).
enum PublicDataSource {
  gemelnet
  pensionnet
}

// Phase 2C-1: lifecycle status of a sync run. Sync execution itself is Phase 2C-2.
enum PublicDataSyncStatus {
  running
  success
  failed
}

// Phase 2C-1: who/what triggered a sync run.
enum PublicDataSyncTrigger {
  manual
  scheduled
}

// Phase 2C-1: best-effort product type classification for a PublicFund.
// GemelNet/PensionNet do not expose a clean product type column, so this
// must remain nullable / allow `unknown` rather than being inferred confidently.
enum PublicFundProductType {
  hishtalmut
  gemel
  hashkaa
  pension
  unknown
}

// ─── Models ───────────────────────────────────────────────────────────────────

// Phase 2B: single-user dev stub. Auth.js integration is planned for a future phase.
// Do not add password/session/account fields here until Auth.js is implemented.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedSavingsHoldings ManagedSavingsHolding[]
}

// Stores the user's personal managed savings holdings.
// Money fields use BigInt minor units (agorot). Fee fields use Int basis points.
// Does NOT store pension funds — those are a future dedicated model.
model ManagedSavingsHolding {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name   String
  type   ManagedSavingsType
  owner  OwnerLabel         @default(self)
  status HoldingStatus      @default(active)

  // User-controlled display order within the holdings table (Phase 2D-1).
  // Lower values render first. Backfilled from createdAt asc on introduction;
  // new holdings are appended (max existing + 1) by createManagedSavingsHolding.
  displayOrder Int @default(0)

  // Money stored as agorot (integer minor units). Never use floats for persisted balances.
  currentBalanceMinor      BigInt @default(0)
  monthlyContributionMinor BigInt @default(0)
  currency                 String @default("ILS")

  // Fees stored as basis points (bps). 100 bps = 1%.
  accumulationFeeBps Int @default(0)
  depositFeeBps      Int @default(0)

  managingCompany String?
  trackName       String?

  // Optional: raw/official fund identifier as entered by the user — unrelated
  // to the publicFundId link below. Never repurposed for matching.
  officialFundId String?

  // Optional: internal DB link to a matched PublicFund record (Phase 2C-3B).
  // User-confirmed only — never auto-linked. SetNull on PublicFund deletion
  // so a personal holding is never deleted as a side effect.
  publicFundId String?
  publicFund   PublicFund? @relation(fields: [publicFundId], references: [id], onDelete: SetNull)

  valuationDate DateTime?

  // Personal notes — sensitive, displayed in expanded row only, not in main table
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, displayOrder])
  @@index([type])
  @@index([officialFundId])
  @@index([publicFundId])
}

// ─── Phase 2C-1: Public Fund Data Foundation ──────────────────────────────────
// Schema/config only. No live Data.gov.il sync, matching, or UI in this phase.
// ManagedSavingsHolding is intentionally NOT linked to PublicFund yet (Phase 2C-3).

// Represents a public GemelNet/PensionNet fund (fund-level, not personal data).
model PublicFund {
  id     String           @id @default(cuid())
  source PublicDataSource

  fundId   String
  fundName String

  managingCompany        String
  managingCompanyLegalId String?
  controllingCorporation String?
  parentCompanyId        String?
  parentCompanyName      String?

  // Nullable: GemelNet does not expose a clean product type column.
  productType PublicFundProductType?

  fundClassification String?
  specialization     String?
  subSpecialization  String?
  targetPopulation   String?

  inceptionDate DateTime?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fundReturns             FundReturn[]
  managedSavingsHoldings  ManagedSavingsHolding[]

  @@unique([source, fundId])
  @@index([source])
  @@index([fundId])
  @@index([fundName])
  @@index([managingCompany])
}

// Monthly public return data for a PublicFund. Fund-level only — never the
// user's personal realized return.
model FundReturn {
  id           String     @id @default(cuid())
  publicFundId String
  publicFund   PublicFund @relation(fields: [publicFundId], references: [id])

  reportPeriod DateTime

  monthlyReturn Decimal @db.Decimal(10, 4)
  ytdReturn     Decimal @db.Decimal(10, 4)

  trailing3YrReturn   Decimal? @db.Decimal(10, 4)
  trailing5YrReturn   Decimal? @db.Decimal(10, 4)
  annualized3YrReturn Decimal? @db.Decimal(10, 4)
  annualized5YrReturn Decimal? @db.Decimal(10, 4)

  // AUM units are not display-approved yet — do not infer/display units in UI.
  assetsUnderManagement    Decimal? @db.Decimal(18, 2)
  assetsUnderManagementRaw String?

  avgAnnualManagementFee Decimal? @db.Decimal(10, 4)
  avgDepositFee          Decimal? @db.Decimal(10, 4)

  sourceResourceId   String
  sourceSnapshotDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([publicFundId, reportPeriod])
  @@index([publicFundId])
  @@index([reportPeriod])
}

// Config record for a known Data.gov.il resource (dataset period), so resource
// IDs are stored in config and not hardcoded in future sync logic.
model PublicDataResource {
  id     String           @id @default(cuid())
  source PublicDataSource

  label      String
  resourceId String

  periodStart DateTime?
  periodEnd   DateTime?

  isCurrent Boolean @default(false)
  isActive  Boolean @default(true)

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, resourceId])
}

// Audit/history record for a public data sync run. No sync logic in this
// phase — used later by the Admin sync UI (Phase 2C-2+).
model PublicDataSyncRun {
  id     String           @id @default(cuid())
  source PublicDataSource

  resourceId String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  status PublicDataSyncStatus @default(running)

  insertedCount Int @default(0)
  updatedCount  Int @default(0)
  skippedCount  Int @default(0)
  errorCount    Int @default(0)

  errorMessage String?

  triggeredBy PublicDataSyncTrigger

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([status])
  @@index([startedAt])
}
