# ─────────────────────────────────────────────────────────────────────────────
# MyBalance — Environment Variables
#
# SETUP:
#   Copy this file to .env for local development:
#     cp .env.example .env
#   Then fill in the values for your environment.
#   NEVER commit .env or any file containing real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── LOCAL DEVELOPMENT (Docker Compose) ───────────────────────────────────────
#
# Start the local DB first:
#   npm run db:local:up
#
# Then run the initial migration and seed:
#   npm run db:migrate:local
#   npm run db:seed:local
#
# These values match the docker-compose.yml configuration exactly.
DATABASE_URL="postgresql://mybalance:mybalance_local_password@localhost:5433/mybalance_local?schema=public"

# ── REMOTE — NEON (production / staging) ─────────────────────────────────────
#
# NEON_DATABASE_URL is a reference placeholder only.
# It is NOT used by Prisma or Next.js at runtime — DATABASE_URL is.
#
# When you are ready to apply approved migrations to Neon:
#   1. Set DATABASE_URL to the Neon connection string in a secure env file (.env.neon, etc.)
#      that is NOT committed to git.
#   2. Run:  npm run db:migrate:deploy
#   3. Never run `prisma migrate dev` against Neon — only `migrate deploy`.
#
NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
